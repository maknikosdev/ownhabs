<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Απαιτείται από το Health Services για την ανάγνωση βημάτων (DataType.STEPS_DAILY). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OwnHabsWear"
        android:supportsRtl="true">

        <!-- Standalone: η εφαρμογή λειτουργεί μόνη της στο ρολόι, δεν απαιτεί το phone app
             να είναι εγκατεστημένο (αν και ο συγχρονισμός δεδομένων φυσικά χρειάζεται το
             OwnHabs στο τηλέφωνο για να έχει νόημα). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:theme="@style/Theme.OwnHabsWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WatchDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/ownhabs/today_habits" />
            </intent-filter>
        </service>

        <!-- Το Health Services API τρέχει αυτή την υπηρεσία στο παρασκήνιο κάθε φορά που
             έχει νέο σωρευτικό σύνολο βημάτων ημέρας να αναφέρει — ακόμα κι όταν η
             εφαρμογή δεν είναι ανοιχτή. Η άδεια PASSIVE_DATA_BINDING διασφαλίζει ότι μόνο
             το ίδιο το Health Services μπορεί να συνδεθεί σε αυτήν. -->
        <service
            android:name=".health.StepsPassiveService"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING"
            android:exported="true" />

    </application>

</manifest>
