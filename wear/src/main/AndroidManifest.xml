<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OwnHabsWear"
        android:supportsRtl="true">

        <!-- Standalone: η εφαρμογή λειτουργεί μόνη της στο ρολόι, δεν απαιτεί το phone app
             να είναι εγκατεστημένο (αν και ο συγχρονισμός δεδομένων φυσικά χρειάζεται το
             OwnHabs στο τηλέφωνο για να έχει νόημα). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:theme="@style/Theme.OwnHabsWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WatchDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/ownhabs/today_habits" />
            </intent-filter>
        </service>

    </application>

</manifest>
