<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Επικεφαλίδα: άνοιγμα εφαρμογής -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HabitPulse"
            android:textColor="#F5F7FB"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Γραμμή 1 -->
    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/row1_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:paddingEnd="10dp"
            android:text="✅" />

        <TextView
            android:id="@+id/row1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5F7FB"
            android:textSize="13sp"
            android:maxLines="1"
            android:text="Habit 1" />

        <TextView
            android:id="@+id/row1_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_log_button_bg"
            android:gravity="center"
            android:textColor="#08141A"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="+" />
    </LinearLayout>

    <!-- Γραμμή 2 -->
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/row2_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:paddingEnd="10dp"
            android:text="✅" />

        <TextView
            android:id="@+id/row2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5F7FB"
            android:textSize="13sp"
            android:maxLines="1"
            android:text="Habit 2" />

        <TextView
            android:id="@+id/row2_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_log_button_bg"
            android:gravity="center"
            android:textColor="#08141A"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="+" />
    </LinearLayout>

    <!-- Γραμμή 3 -->
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/row3_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:paddingEnd="10dp"
            android:text="✅" />

        <TextView
            android:id="@+id/row3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5F7FB"
            android:textSize="13sp"
            android:maxLines="1"
            android:text="Habit 3" />

        <TextView
            android:id="@+id/row3_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_log_button_bg"
            android:gravity="center"
            android:textColor="#08141A"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Άνοιξε την εφαρμογή για να προσθέσεις συνήθειες"
        android:textColor="#8A93A6"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
